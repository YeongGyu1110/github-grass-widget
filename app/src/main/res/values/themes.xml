<resources>
    <style name="Theme.GithubWidget" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Compose 가 첫 화면을 그리기 전에도 앱과 같은 배경이 보이도록 (다크 모드에서 흰 화면 번쩍임 방지) -->
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- 앱 실행 화면: 앱 배경색 위에서 잔디 로고 칸이 하나씩 채워진다 -->
    <style name="Theme.GithubWidget.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.GithubWidget</item>
    </style>
</resources>
